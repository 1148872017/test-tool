{
  "name": "test-tool",
  "productName": "测试工作台",
  "version": "0.24.1",
  "description": "本地测试工作台：密码库 / 测试账号 / SQL 片段 / 接口记录 / 测试笔记",
  "author": "",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "node scripts/build.mjs",
    "start": "npm run build:renderer && electron .",
    "shot": "node scripts/shot.mjs",
    "test:main": "node scripts/test-main.cjs",
    "test:migrate": "node scripts/test-migrate.cjs",
    "test:cases": "node scripts/test-cases.cjs",
    "test:links": "node scripts/test-links.cjs",
    "test:openapi": "node scripts/test-openapi.cjs",
    "test:jmx": "node scripts/test-jmx.cjs",
    "test": "node scripts/test-main.cjs && node scripts/test-migrate.cjs && node scripts/test-cases.cjs && node scripts/test-links.cjs && node scripts/test-openapi.cjs && node scripts/test-jmx.cjs && node scripts/test-jtl.cjs && node scripts/test-templates.cjs && node scripts/test-knowledge.cjs && node scripts/test-notes.cjs",
    "dist": "npm run build:renderer && electron-builder --win portable --x64",
    "test:jtl": "node scripts/test-jtl.cjs",
    "test:templates": "node scripts/test-templates.cjs",
    "test:knowledge": "node scripts/test-knowledge.cjs",
    "test:notes": "node scripts/test-notes.cjs",
    "dist:installer": "npm run build:renderer && electron-builder --win nsis --x64",
    "package:docs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-docs.ps1"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.29.3",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.testtool.workbench",
    "productName": "测试工作台",
    "artifactName": "test-tool-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "shared/**/*",
      "dist/**/*",
      "build/tray.png",
      "build/icon.ico",
      "package.json",
      "build/splash.bmp",
      "build/installer.nsh"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "compression": "normal",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "测试工作台",
      "installerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "test-tool-Setup-${version}-${arch}.${ext}",
      "warningsAsErrors": false
    }
  }
}
