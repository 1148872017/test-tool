{
  "name": "test-tool",
  "productName": "测试工作台",
  "version": "0.48.0",
  "description": "本地测试工作台：密码库 / 测试账号 / SQL 片段 / 接口记录 / 测试笔记",
  "author": "",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "start": "npm run build:renderer && electron .",
    "shot": "node scripts/shot.mjs",
    "test:main": "node scripts/test-main.cjs",
    "test:migrate": "node scripts/test-migrate.cjs",
    "test:cases": "node scripts/test-cases.cjs",
    "test:links": "node scripts/test-links.cjs",
    "test:openapi": "node scripts/test-openapi.cjs",
    "test:jmx": "node scripts/test-jmx.cjs",
    "test": "node scripts/run-unit.cjs",
    "test:unit": "node scripts/run-unit.cjs",
    "test:env": "node scripts/test-preflight.cjs && node scripts/run-env.cjs",
    "test:all": "node scripts/run-all.cjs",
    "test:preflight": "node scripts/test-preflight.cjs",
    "dist": "npm run build:renderer && electron-builder --win portable --x64",
    "test:jtl": "node scripts/test-jtl.cjs",
    "test:templates": "node scripts/test-templates.cjs",
    "test:knowledge": "node scripts/test-knowledge.cjs",
    "test:notes": "node scripts/test-notes.cjs",
    "dist:installer": "npm run build:renderer && electron-builder --win nsis --x64",
    "package:docs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-docs.ps1",
    "test:updater": "node scripts/test-updater.cjs",
    "test:curl": "node scripts/test-curl.cjs",
    "test:json-table": "node scripts/test-json-table.cjs",
    "test:vars": "node scripts/test-vars.cjs",
    "test:metrics": "node scripts/test-metrics.cjs",
    "test:installer": "node scripts/test-installer.cjs",
    "test:accounts": "node scripts/test-accounts.cjs",
    "test:runner": "node scripts/test-runner.cjs",
    "test:linebuffer": "node scripts/test-linebuffer.cjs",
    "test:codegen": "node scripts/test-codegen.cjs",
    "test:skin": "node scripts/test-skin.cjs",
    "test:allure": "node scripts/test-allure.cjs",
    "test:codescan": "node scripts/test-codescan.cjs",
    "test:scriptgen": "node scripts/test-scriptgen.cjs",
    "test:gaps": "node scripts/test-gaps.cjs",
    "test:fixes": "node scripts/test-fixes-361.cjs",
    "test:gaps2": "node scripts/test-gaps2.cjs",
    "test:jsx": "node scripts/test-jsx-text.cjs",
    "test:mock": "node scripts/test-mock-coverage.cjs",
    "test:demo": "node scripts/test-demo.cjs",
    "test:iotip": "node scripts/test-io-tooltip.cjs",
    "test:v41": "node scripts/test-v41.cjs",
    "test:brand": "node scripts/test-brand.cjs",
    "test:ipc": "node scripts/test-ipc-unique.cjs",
    "test:security": "node scripts/test-security.cjs",
    "test:startup": "node scripts/test-startup.cjs",
    "test-rules": "node scripts/test-rules.cjs",
    "test-recycle": "node scripts/test-recycle.cjs",
    "test-codelab": "node scripts/test-codelab.cjs",
    "test-faker": "node scripts/test-faker.cjs",
    "test:debounce": "node scripts/test-debounce.cjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "ejs": "^3.1.10",
    "js-yaml": "^4.3.2",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.2",
    "antd": "^5.29.3",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.2",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.testtool.workbench",
    "productName": "测试工作台",
    "artifactName": "test-tool-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "shared/**/*",
      "dist/**/*",
      "!dist/preview/**",
      "build/tray.png",
      "build/icon.ico",
      "package.json",
      "build/splash.bmp",
      "build/installer.nsh"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "compression": "normal",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "测试工作台",
      "installerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "artifactName": "test-tool-Setup-${version}-${arch}.${ext}",
      "warningsAsErrors": false
    },
    "executableName": "test-tool"
  }
}
